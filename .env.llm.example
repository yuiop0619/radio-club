# ============================================================
# RADIO CLUB · MODEL RC-2006 叙事层配置（Phase 4）
#
# 用法：
#   1) 复制本文件为 .env.llm
#   2) 按下面任一方案填写
#   3) python tools/deploy.py  （部署脚本会把它上传到服务器 /opt/rc-api/.env）
#
# .env.llm 已被 .gitignore 忽略，不会进仓库。
# 留空 / 不部署此文件 = 功能自动降级为本地模板，页面依然完整可用。
# ============================================================

# ---- 方案一：云 API（以 DeepSeek 为例） ----
RC_LLM_BASE_URL=https://api.deepseek.com/v1
RC_LLM_API_KEY=sk-在这里填你的密钥
RC_LLM_MODEL=deepseek-chat

# ---- 方案二：本地推理（Ollama；先 `ollama serve` 并 `ollama pull qwen2.5:7b-instruct`） ----
# RC_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RC_LLM_API_KEY=
# RC_LLM_MODEL=qwen2.5:7b-instruct

# ---- 方案三：本地推理（OpenVINO GenAI 的 OpenAI 兼容服务） ----
# RC_LLM_BASE_URL=http://127.0.0.1:8000/v3
# RC_LLM_API_KEY=
# RC_LLM_MODEL=Qwen2.5-7B-Instruct-int4-ov

# ---- 可选调参 ----
RC_LLM_TIMEOUT_MS=12000
RC_LLM_MAX_TOKENS=700
RC_LLM_TEMPERATURE=0.85
